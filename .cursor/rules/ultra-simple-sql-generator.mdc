     WHEN fix_result = 1 AND (submit_time - create_time) < 600000 THEN 70 + (600000 - (submit_time - create_time)) / 20000  
     WHEN fix_result = 1 THEN 50
     ELSE 0
   END as learning_efficiency_score
   
