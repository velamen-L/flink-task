    'database-name' = '${从ER图entity配置读取database}',
    'hostname' = '${从env配置读取}',
    'lookup.cache.max-rows' = '${从entity或env配置读取}',
    'lookup.cache.strategy' = 'LRU',
    'lookup.cache.ttl' = '${优先entity配置ttl，否则使用env默认值}',
