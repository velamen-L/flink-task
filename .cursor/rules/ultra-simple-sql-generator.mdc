    'table-name' = 'dim_table',
    'username' = '${从env配置读取}'
);

-- 结果表定义 (MySQL)
CREATE TEMPORARY TABLE result_table (
    id STRING NOT NULL,
    field STRING,
    PRIMARY KEY (id) NOT ENFORCED
) WITH (
    'connector' = 'mysql',
    'database-name' = '${从result_table配置读取database}',
    'hostname' = '${从env配置读取}',
    'password' = '${从env配置读取}',
    'port' = '${从env配置读取}',
